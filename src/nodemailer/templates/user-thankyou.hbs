<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thank You for Your Inquiry – Namoh Tourism</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;color:#111827;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f4f4f5;min-width:100%;">
      <tr>
        <td align="center" style="padding:40px 16px;">

          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 6px 24px rgba(0,0,0,0.08);border:1px solid #e5e7eb;">

            <!-- Top Gradient Bar -->
            <tr>
              <td style="height:5px;background:linear-gradient(90deg, #002855 0%, #d4af37 100%);"></td>
            </tr>

            <!-- Header with Logo -->
            <tr>
              <td align="center" style="padding:28px 40px 20px;text-align:center;">
                <img
                  src="{{logoUrl}}"
                  alt="Namoh Tourism"
                  width="150"
                  style="display:block;margin:0 auto;border:0;outline:none;max-width:150px;height:auto;"
                />
              </td>
            </tr>

            <!-- Divider -->
            <tr>
              <td style="padding:0 40px;">
                <div style="height:1px;background:#ececec;"></div>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding:32px 40px;">

                <!-- Status Badge -->
                <table cellpadding="0" cellspacing="0" border="0" style="margin-bottom:20px;">
                  <tr>
                    <td style="background:#ecfdf5;border:1px solid #a7f3d0;border-radius:20px;padding:5px 14px;">
                      <span style="font-size:11px;font-weight:700;color:#047857;letter-spacing:.5px;text-transform:uppercase;">
                        ✦ Inquiry Received Successfully
                      </span>
                    </td>
                  </tr>
                </table>

                <!-- Main Greeting -->
                <h2 style="margin:0 0 12px;font-size:24px;font-weight:800;color:#002855;line-height:1.3;">
                  Thank You, {{name}}!
                </h2>

                <p style="margin:0 0 16px;font-size:14.5px;line-height:24px;color:#475569;">
                  We have successfully received your travel inquiry for <strong style="color:#002855;">{{destination}}</strong>. 
                </p>

                <p style="margin:0 0 24px;font-size:14px;line-height:24px;color:#64748b;">
                  Our dedicated holiday expert is now designing a tailor-made itinerary along with the best quotation for your journey. We will connect with you shortly via phone or WhatsApp.
                </p>

                <!-- Trip Summary Card -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#fafafa;border:1px solid #e5e7eb;border-radius:12px;margin-bottom:24px;">
                  <tr>
                    <td style="padding:18px 22px;">
                      <h4 style="margin:0 0 12px;font-size:12px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:0.5px;">
                        Trip Inquiry Summary:
                      </h4>

                      <table width="100%" cellpadding="0" cellspacing="0" style="font-size:13.5px;">
                        <tr>
                          <td style="padding:8px 0;width:42%;color:#6b7280;font-weight:600;">Destination</td>
                          <td style="padding:8px 0;color:#002855;font-weight:700;">{{destination}}</td>
                        </tr>
                        <tr>
                          <td colspan="2" style="border-top:1px solid #f0f0f0;"></td>
                        </tr>
                        <tr>
                          <td style="padding:8px 0;color:#6b7280;font-weight:600;">Travel Date</td>
                          <td style="padding:8px 0;color:#111827;font-weight:600;">{{date}}</td>
                        </tr>
                        <tr>
                          <td colspan="2" style="border-top:1px solid #f0f0f0;"></td>
                        </tr>
                        <tr>
                          <td style="padding:8px 0;color:#6b7280;font-weight:600;">Duration</td>
                          <td style="padding:8px 0;color:#111827;font-weight:600;">{{days}} Days</td>
                        </tr>
                        <tr>
                          <td colspan="2" style="border-top:1px solid #f0f0f0;"></td>
                        </tr>
                        <tr>
                          <td style="padding:8px 0;color:#6b7280;font-weight:600;">Persons</td>
                          <td style="padding:8px 0;color:#111827;font-weight:600;">{{persons}} Persons</td>
                        </tr>
                        <tr>
                          <td colspan="2" style="border-top:1px solid #f0f0f0;"></td>
                        </tr>
                        <tr>
                          <td style="padding:8px 0;color:#6b7280;font-weight:600;">Departure City</td>
                          <td style="padding:8px 0;color:#111827;font-weight:600;">{{departureCity}}</td>
                        </tr>
                      </table>

                    </td>
                  </tr>
                </table>

                <!-- Immediate Assistance Box -->
                <div style="background:#f8fafc;border:1px solid #e2e8f0;border-left:4px solid #002855;border-radius:8px;padding:16px 20px;">
                  <h4 style="margin:0 0 6px;font-size:13px;font-weight:700;color:#002855;">
                    Need Immediate Assistance?
                  </h4>
                  <p style="margin:0 0 10px;font-size:13px;color:#475569;line-height:20px;">
                    Feel free to reach our holiday desk directly:
                  </p>
                  <p style="margin:0;font-size:13.5px;color:#002855;font-weight:600;">
                    📞 Phone / WhatsApp: <a href="tel:+918580636332" style="color:#002855;text-decoration:none;">+91 85806 36332</a><br />
                    ✉️ Email: <a href="mailto:namohtourism@gmail.com" style="color:#0284c7;text-decoration:none;">namohtourism@gmail.com</a>
                  </p>
                </div>

              </td>
            </tr>

            <!-- Divider -->
            <tr>
              <td style="padding:0 40px;">
                <div style="height:1px;background:#ececec;"></div>
              </td>
            </tr>

            <!-- Signature -->
            <tr>
              <td style="padding:24px 40px 20px;">
                <p style="margin:0 0 4px;font-size:13.5px;color:#374151;">
                  Warm regards,
                </p>
                <p style="margin:0;font-size:15px;font-weight:800;color:#002855;">
                  Namoh Tourism Team
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td align="center" style="background:#fafafa;border-top:1px solid #ececec;padding:20px 40px;text-align:center;">
                <p style="margin:0 0 6px;font-size:12px;color:#64748b;line-height:18px;">
                  Prasad Bhawan, Khalini, Distt. Shimla, H.P. - 171002
                </p>
                <p style="margin:0;font-size:11px;color:#9ca3af;line-height:16px;">
                  © {{currentYear}} Namoh Tourism. All rights reserved.
                </p>
              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>
  </body>
</html>
