<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Guest Review – Namoh Tourism</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;color:#111827;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f4f4f5;min-width:100%;">
      <tr>
        <td align="center" style="padding:40px 16px;">

          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 6px 24px rgba(0,0,0,0.08);border:1px solid #e5e7eb;">

            <!-- Top Gradient Bar -->
            <tr>
              <td style="height:5px;background:linear-gradient(90deg, #f59e0b 0%, #002855 100%);"></td>
            </tr>

            <!-- Header -->
            <tr>
              <td align="center" style="padding:28px 40px 20px;text-align:center;">
                <img
                  src="{{logoUrl}}"
                  alt="Namoh Tourism"
                  width="150"
                  style="display:block;margin:0 auto;border:0;outline:none;max-width:150px;height:auto;"
                />
              </td>
            </tr>

            <!-- Divider -->
            <tr>
              <td style="padding:0 40px;">
                <div style="height:1px;background:#ececec;"></div>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding:32px 40px;">

                <!-- Status Badge -->
                <table cellpadding="0" cellspacing="0" border="0" style="margin-bottom:20px;">
                  <tr>
                    <td style="background:#fef3c7;border:1px solid #fde68a;border-radius:20px;padding:6px 16px;">
                      <span style="font-size:12px;font-weight:700;color:#92400e;letter-spacing:.5px;text-transform:uppercase;">
                        ⭐ New Customer Review Submitted
                      </span>
                    </td>
                  </tr>
                </table>

                <!-- Heading -->
                <h2 style="margin:0 0 10px;font-size:22px;font-weight:800;color:#002855;line-height:1.3;">
                  Review for: <span style="color:#d97706;">{{tour}}</span>
                </h2>

                <p style="margin:0 0 20px;font-size:14px;line-height:22px;color:#64748b;">
                  A guest has submitted feedback on the Namoh Tourism website. Since moderation is enabled, this review will not appear on the website until you approve it.
                </p>

                <!-- Rating Box -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#fffbeb;border:1px solid #fde68a;border-radius:12px;margin-bottom:20px;">
                  <tr>
                    <td style="padding:16px 20px;text-align:center;">
                      <div style="font-size:24px;letter-spacing:4px;color:#f59e0b;margin-bottom:4px;">
                        {{starsDisplay}}
                      </div>
                      <div style="font-size:14px;font-weight:800;color:#92400e;">
                        {{rating}} out of 5 Stars
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- Details Card -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#fafafa;border:1px solid #e5e7eb;border-radius:12px;margin-bottom:24px;">
                  <tr>
                    <td style="padding:20px 24px;">
                      <table width="100%" cellpadding="0" cellspacing="0" style="font-size:13.5px;">

                        <tr>
                          <td style="padding:8px 0;width:38%;">
                            <span style="font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.5px;">
                              Guest Name
                            </span>
                          </td>
                          <td style="padding:8px 0;">
                            <span style="font-size:14px;font-weight:700;color:#002855;">
                              {{name}}
                            </span>
                          </td>
                        </tr>

                        <tr>
                          <td colspan="2" style="border-top:1px solid #e5e7eb;"></td>
                        </tr>

                        <tr>
                          <td style="padding:8px 0;">
                            <span style="font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.5px;">
                              Email Address
                            </span>
                          </td>
                          <td style="padding:8px 0;">
                            <a href="mailto:{{email}}" style="font-size:14px;font-weight:600;color:#0284c7;text-decoration:none;">
                              {{email}}
                            </a>
                          </td>
                        </tr>

                        <tr>
                          <td colspan="2" style="border-top:1px solid #e5e7eb;"></td>
                        </tr>

                        <tr>
                          <td style="padding:8px 0;">
                            <span style="font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.5px;">
                              Location / City
                            </span>
                          </td>
                          <td style="padding:8px 0;">
                            <span style="font-size:14px;font-weight:600;color:#111827;">
                              {{location}}
                            </span>
                          </td>
                        </tr>

                        <tr>
                          <td colspan="2" style="border-top:1px solid #e5e7eb;"></td>
                        </tr>

                        <tr>
                          <td style="padding:8px 0;">
                            <span style="font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.5px;">
                              Date
                            </span>
                          </td>
                          <td style="padding:8px 0;">
                            <span style="font-size:14px;font-weight:600;color:#111827;">
                              {{date}}
                            </span>
                          </td>
                        </tr>

                      </table>
                    </td>
                  </tr>
                </table>

                <!-- Review Comment Box -->
                <div style="margin-bottom:24px;">
                  <span style="font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.5px;display:block;margin-bottom:8px;">
                    Review Message / Experience:
                  </span>
                  <div style="background:#f8fafc;border-left:4px solid #f59e0b;padding:16px 20px;border-radius:0 8px 8px 0;font-size:14.5px;line-height:24px;color:#334155;font-style:italic;">
                    &ldquo;{{comment}}&rdquo;
                  </div>
                </div>

                <!-- Admin Action: Copy Paste JSON Snippet -->
                <div style="background:#0f172a;border-radius:12px;padding:20px;margin-bottom:24px;">
                  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
                    <span style="color:#38bdf8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;">
                      📋 Admin Action: Add to Website (Copy & Paste into content.json)
                    </span>
                  </div>
                  <pre style="margin:0;background:#020617;padding:14px;border-radius:8px;color:#f8fafc;font-size:12px;font-family:Consolas, Monaco, 'Courier New', monospace;overflow-x:auto;white-space:pre-wrap;word-break:break-word;line-height:1.5;">{{jsonSnippet}}</pre>
                  <p style="margin:10px 0 0;font-size:11px;color:#94a3b8;line-height:16px;">
                    💡 <em>To display this review on the homepage: Open <code>src/data/content.json</code>, navigate to the <code>"reviews"</code> array, and paste this snippet.</em>
                  </p>
                </div>

              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="background:#f8fafc;padding:24px 40px;border-top:1px solid #e5e7eb;text-align:center;">
                <p style="margin:0 0 6px;font-size:13px;font-weight:700;color:#002855;">
                  Namoh Tourism Admin Alert
                </p>
                <p style="margin:0;font-size:12px;color:#94a3b8;">
                  This is an automated notification from the Guest Review Portal.
                </p>
              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>
  </body>
</html>
